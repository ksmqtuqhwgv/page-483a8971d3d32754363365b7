hero-anchor-nav a:hover {color: var(--cyan-light);border-color: var(--cyan)}\n    /* 右侧信息面板 */\n    .hero-panel {background: var(--surface);border-radius: 24px;padding: 2.25rem;box-shadow: var(--shadow);border: 1px solid var(--border);display: flex;flex-direction: column;justify-content: space-between}\n    .panel-header {border-bottom: 1px solid var(--border);padding-bottom: 1rem;margin-bottom: 1.5rem}\n    .panel-label {font-size: 0.75rem;color: var(--cyan-light);text-transform: uppercase;letter-spacing: 0.1em}\n    .panel-title {font-size: 1.25rem;font-weight: 600;color: var(--text-main);margin-top: 0.25rem}\n    .panel-metrics {display: grid;grid-template-columns: 1fr 1fr;gap: 1rem;margin-bottom: 1.5rem}\n    .metric-box {background: var(--surface-subtle);border-radius: 16px;padding: 1rem 1.15rem}\n    .metric-name {font-size: 0.75rem;color: var(--text-muted);margin-bottom: 0.25rem}\n    .metric-val {font-size: 1.2rem;font-weight: 700;color: var(--text-main)}\n    .panel-desc {font-size: 0.875rem;color: var(--text-muted);line-height: 1.6}\n    /* Section Shared */\n    section {margin-bottom: 5rem}\n    .section-header {margin-bottom: 2rem}\n    h2 {font-size: 1.85rem;font-weight: 700;letter-spacing: -0.01em;color: var(--text-main);margin-bottom: 0.5rem}\n    .section-subtitle {font-size: 0.95rem;color: var(--text-muted)}\n    /* Plans: 2 纵向列表逐行展开 */\n    .plans-container {display: flex;flex-direction: column;gap: 1.25rem}\n    /* Card: 3 大圆角软阴影 */\n    .plan-row {background: var(--surface);border-radius: 20px;box-shadow: var(--shadow);border: 1px solid var(--border);padding: 1.75rem 2rem;display: grid;grid-template-columns: 240px 1fr auto;gap: 2rem;align-items: center}\n    .plan-row.featured {border-color: rgba(6, 182, 212, 0.45);background: linear-gradient(135deg, rgba(30, 41, 59, 1) 0%, rgba(15, 23, 42, 1) 100%)}\n    .plan-meta h3 {font-size: 1.35rem;font-weight: 700;color: var(--text-main);margin-bottom: 0.4rem;display: flex;align-items: center;gap: 0.5rem}\n    .badge {font-size: 0.7rem;background: var(--cyan);color: #041f26;font-weight: 700;padding: 0.15rem 0.5rem;border-radius: 999px}\n    .plan-price-main {font-size: 1.6rem;font-weight: 800;color: var(--cyan-light)}\n    .plan-price-sub {font-size: 0.8rem;color: var(--text-muted)}\n    .plan-features-list {list-style: none;display: flex;flex-wrap: wrap;gap: 0.6rem 1.25rem}\n    .plan-features-list li {font-size: 0.875rem;color: var(--text-muted);display: flex;align-items: center;gap: 0.4rem}\n    .plan-features-list li::before {content: \"•\";color: var(--cyan-light);font-weight: bold}\n    .plan-action {text-align: right}\n    .btn-action {display: inline-block;font-size: 0.875rem;font-weight: 600;background: var(--surface-subtle);color: var(--text-main);padding: 0.65rem 1.25rem;border-radius: 12px;border: 1px solid var(--border);transition: all 0.15s ease;white-space: nowrap}\n    .plan-row.featured .btn-action {background: var(--cyan);color: #041f26;border-color: var(--cyan)}\n    .btn-action:hover {border-color: var(--cyan-light);color: #ffffff}\n    .plan-row.featured .btn-action:hover {background: var(--cyan-light);color: #041f26}\n    /* Steps / Setup */\n    .steps-grid {display: grid;grid-template-columns: repeat(3, 1fr);gap: 1.25rem}\n    .step-card {background: var(--surface);border-radius: 20px;padding: 1.75rem;border: 1px solid var(--border);box-shadow: var(--shadow)}\n    .step-num {font-size: 0.85rem;font-weight: 700;color: var(--cyan-light);margin-bottom: 0.75rem;letter-spacing: 0.05em}\n    .step-card h3 {font-size: 1.15rem;color: var(--text-main);margin-bottom: 0.5rem}\n    .step-card p {font-size: 0.875rem;color: var(--text-muted);line-height: 1.6}\n    /* Clients */\n    .clients-card {background: var(--surface);border-radius: 20px;padding: 2rem;border: 1px solid var(--border);box-shadow: var(--shadow)}\n    .clients-grid {display: grid;grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));gap: 1rem;margin-top: 1.25rem}\n    .client-item {background: var(--surface-subtle);border-radius: 14px;padding: 1.15rem;border: 1px solid var(--border)}\n    .client-item h4 {font-size: 1rem;color: var(--text-main);margin-bottom: 0.35rem}\n    .client-item p {font-size: 0.8rem;color: var(--text-muted)}\n    /* FAQ: 2 编号列表 */\n    .faq-numbered-list {list-style: none;display: flex;flex-direction: column;gap: 1.25rem}\n    .faq-item {background: var(--surface);border-radius: 20px;padding: 1.75rem 2rem;box-shadow: var(--shadow);border: 1px solid var(--border);display: grid;grid-template-columns: 50px 1fr;gap: 1.5rem}\n    .faq-index {font-size: 1.25rem;font-weight: 800;color: var(--cyan-light);line-height: 1.2}\n    .faq-content h3 {font-size: 1.15rem;font-weight: 600;color: var(--text-main);margin-bottom: 0.5rem}\n    .faq-content p {font-size: 0.9rem;color: var(--text-muted);line-height: 1.65}\n    /* Footer */\n    footer {border-top: 1px solid var(--border);padding-top: 2rem;font-size: 0.825rem;color: var(--text-muted);display: flex;justify-content: space-between;align-items: center;flex-wrap: wrap;gap: 1rem}\n    /* Responsive */\n    @media (max-width: 900px) {.hero-split {\n        grid-template-columns: 1fr;}\n      .plan-row {\n        grid-template-columns: 1fr;gap: 1.25rem;}\n      .plan-action {\n        text-align: left;}\n      .steps-grid {\n        grid-template-columns: 1fr;}}\n    @media (max-width: 600px) {\n      h1 {font-size: 2.2rem}\n      .faq-item {grid-template-columns: 1fr;gap: 0.5rem}\n    }\n  </style><main>\n    \n    <div class=\"hero-split\">\n      <div class=\"hero-text\">\n        <div>\n          <span class=\"hero-tag\">网络节点管理平台</span>\n          <h1>GLaDOS <span>智能路由</span> 与接入终端</h1>\n          <p class=\"hero-summary\">\n            为跨平台设备提供稳固的协议转发方案。按需分配流量，集中管理订阅配置，开箱即用。\n          </p>\n        </div>\n        <nav class=\"hero-anchor-nav\" aria-label=\"页面段落索引\">\n          <a href=\"#plans\">订阅方案</a>\n          <a href=\"#setup\">配置指引</a>\n          <a href=\"#clients\">终端支持</a>\n          <a href=\"#faq\">常见疑问</a>\n        </nav>\n      </div>\n\n      <div class=\"hero-panel\">\n        <div class=\"panel-header\">\n          <div class=\"panel-label\">节点系统概览</div>\n          <div class=\"panel-title\">接入调度控制台</div>\n        </div>\n        <div class=\"panel-metrics\">\n          <div class=\"metric-box\">\n            <div class=\"metric-name\">服务协议支持</div>\n            <div class=\"metric-val\">多协议兼容</div>\n          </div>\n          <div class=\"metric-box\">\n            <div class=\"metric-name\">配置同步方式</div>\n            <div class=\"metric-val\">订阅 URL</div>\n          </div>\n        </div>\n        <p class=\"panel-desc\">\n          终端凭证自动校验，无需繁琐设置。节点状态实时监测，故障自动重路由，保障通信链路不中断。\n        </p>\n      </div>\n    </div>\n\n    \n    <section id=\"plans\">\n      <div class=\"section-header\">\n        <h2>服务方案</h2>\n        <p class=\"section-subtitle\">按用量规格选择合适周期的订阅方案。</p>\n      </div>\n      <div class=\"plans-container\">\n        \n        <article class=\"plan-row\">\n          <div class=\"plan-meta\">\n            <h3>基础版</h3>\n            <div class=\"plan-price-main\">¥15 <span>/ 月</span></div>\n            <div class=\"plan-price-sub\">按年付仅需 ¥150/年</div>\n          </div>\n          <div class=\"plan-body\">\n            <ul class=\"plan-features-list\">\n              <li>每月 100GB 极速流量</li>\n              <li>支持 3 台设备同时在线</li>\n              <li>解锁基础流媒体</li>\n              <li>普通线路节点池</li>\n            </ul>\n          </div>\n          <div class=\"plan-action\">\n            <a href=\"#\" class=\"btn-action\">选择基础版</a>\n          </div>\n        </article>\n\n        \n        <article class=\"plan-row featured\">\n          <div class=\"plan-meta\">\n            <h3>旗舰版 <span class=\"badge\">推荐</span></h3>\n            <div class=\"plan-price-main\">¥35 <span>/ 月</span></div>\n            <div class=\"plan-price-sub\">按年付仅需 ¥350/年</div>\n          </div>\n          <div class=\"plan-body\">\n            <ul class=\"plan-features-list\">\n              <li>每月 300GB 极速流量</li>\n              <li>支持 5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线游戏加速优化</li>\n              <li>7x24 优先工单支持</li>\n            </ul>\n          </div>\n          <div class=\"plan-action\">\n            <a href=\"#\" class=\"btn-action\">选择旗舰版</a>\n          </div>\n        </article>\n\n        \n        <article class=\"plan-row\">\n          <div class=\"plan-meta\">\n            <h3>团队版</h3>\n            <div class=\"plan-price-main\">¥85 <span>/ 月</span></div>\n            <div class=\"plan-price-sub\">按年付仅需 ¥850/年</div>\n          </div>\n          <div class=\"plan-body\">\n            <ul class=\"plan-features-list\">\n              <li>每月 1000GB 极速流量</li>\n              <li>支持 20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理服务</li>\n            </ul>\n          </div>\n          <div class=\"plan-action\">\n            <a href=\"#\" class=\"btn-action\">选择团队版</a>\n          </div>\n        </article>\n      </div>\n    </section>\n\n    \n    <section id=\"setup\">\n      <div class=\"section-header\">\n        <h2>使用流程</h2>\n        <p class=\"section-subtitle\">三步完成初始连接，快速接入服务。</p>\n      </div>\n      <div class=\"steps-grid\">\n        <div class=\"step-card\">\n          <div class=\"step-num\">STEP 01</div>\n          <h3>获取接入凭证</h3>\n          <p>在控制中心选择合适的配置方案，复制生成的个人专属订阅链接或节点二维码。</p>\n        </div>\n        <div class=\"step-card\">\n          <div class=\"step-num\">STEP 02</div>\n          <h3>导入客户端应用</h3>\n          <p>打开支持相应协议的代理软件，将订阅链接粘贴至配置管理器并点击同步节点列表。</p>\n        </div>\n        <div class=\"step-card\">\n          <div class=\"step-num\">STEP 03</div>\n          <h3>开启分流转发</h3>\n          <p>根据需求选择路由模式（规则分流或全局），启动服务即可完成安全代理通信。</p>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"clients\">\n      <div class=\"clients-card\">\n        <div class=\"section-header\">\n          <h2>客户端支持</h2>\n          <p class=\"section-subtitle\">兼容当前主流操作系统及第三方通用代理客户端工具。</p>\n        </div>\n        <div class=\"clients-grid\">\n          <div class=\"client-item\">\n            <h4>Windows</h4>\n            <p>支持 Clash Verge、v2rayN 等通用客户端。</p>\n          </div>\n          <div class=\"client-item\">\n            <h4>macOS</h4>\n            <p>支持 Clash Verge Rev、Surge、Sing-box 等。</p>\n          </div>\n          <div class=\"client-item\">\n            <h4>iOS / iPadOS</h4>\n            <p>支持 Shadowrocket、Quantumult X、Loon 等。</p>\n          </div>\n          <div class=\"client-item\">\n            <h4>Android</h4>\n            <p>支持 Clash Meta for Android、v2rayNG 等。</p>\n          </div>\n          <div class=\"client-item\">\n            <h4>Linux / 路由器</h4>\n            <p>支持 ShellClash、OpenWrt 固件分流插件。</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"faq\">\n      <div class=\"section-header\">\n        <h2>常见问题</h2>\n        <p class=\"section-subtitle\">日常使用与方案配置中的典型解答。</p>\n      </div>\n      <ol class=\"faq-numbered-list\">\n        <li class=\"faq-item\">\n          <div class=\"faq-index\">01</div>\n          <div class=\"faq-content\">\n            <h3>如何获取并更新订阅节点信息？</h3>\n            <p>在个人中心复制对应的订阅 URL，将其填入客户端的订阅设置项。设置定时更新或在节点失效时手动点击更新，客户端将拉取最新的服务器地址与路由规则。</p>\n          </div>\n        </li>\n        <li class=\"faq-item\">\n          <div class=\"faq-index\">02</div>\n          <div class=\"faq-content\">\n            <h3>多台设备同时在线会产生冲突吗？</h3>\n            <p>不会冲突。方案允许对应数量的设备同时建立连接，各设备共享所属套餐的总计流量池，互不干扰。</p>\n          </div>\n        </li>\n        <li class=\"faq-item\">\n          <div class=\"faq-index\">03</div>\n          <div class=\"faq-content\">\n            <h3>流量用尽后连接会发生什么？</h3>\n            <p>当月配额流量耗尽后，节点连接将暂时停止，直到下一个账单周期重置。若有持续需求，可在控制台升级方案或补充用量加油包。</p>\n          </div>\n        </li>\n        <li class=\"faq-item\">\n          <div class=\"faq-index\">04</div>\n          <div class=\"faq-content\">\n            <h3>节点连接不稳定或延迟过高如何排查？</h3>\n            <p>首先在客户端执行延迟测速，切换为当前延迟较低的可用节点；若仍异常，请尝试更新订阅确认节点 IP 是否已变更，或检查本地网络 DNS 设置。</p>\n          </div>\n        </li>\n      </ol>\n    </section>\n\n    \n    <footer>\n      <div>© GLaDOS. 网络接入服务与技术文档.</div>\n      <div>基于通用开放协议构建 · 持续维护</div>\n    </footer>\n  </main>",
